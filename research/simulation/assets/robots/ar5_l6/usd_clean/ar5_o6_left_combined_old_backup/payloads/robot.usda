#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ar5_o6_left"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
