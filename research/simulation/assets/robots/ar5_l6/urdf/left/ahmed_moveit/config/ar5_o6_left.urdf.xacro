<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ar5_o6_left">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ar5_o6_left urdf file -->
    <xacro:include filename="/media/omen/88D2C6C4D2C6B5AA/TianjinUniversity/research/simulation/assets/robots/ar5_l6/urdf/left/ar5_o6_left_moveit.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ar5_o6_left.ros2_control.xacro" />


    <xacro:ar5_o6_left_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
