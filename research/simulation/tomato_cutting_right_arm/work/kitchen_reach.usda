def "ReachLooks"
{
    def Material "neutral"
    {
        token outputs:surface.connect = </ReachLooks/neutral/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.65, 0.62)
            float inputs:metallic = 0
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }

    def Material "wood"
    {
        token outputs:surface.connect = </ReachLooks/wood/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.38, 0.18, 0.07)
            float inputs:metallic = 0
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }

    def Material "metal"
    {
        token outputs:surface.connect = </ReachLooks/metal/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.55, 0.58, 0.62)
            float inputs:metallic = 0.8
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }

    def Material "handle"
    {
        token outputs:surface.connect = </ReachLooks/handle/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.035, 0.025, 0.02)
            float inputs:metallic = 0
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }

    def Material "white"
    {
        token outputs:surface.connect = </ReachLooks/white/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.82, 0.82, 0.8)
            float inputs:metallic = 0
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
}

