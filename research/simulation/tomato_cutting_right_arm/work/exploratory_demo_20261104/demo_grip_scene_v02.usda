#usda 1.0
(
    subLayers = [
        @/home/omen/teamwork_projects/tomato_cutting_right_arm/work/exploratory_demo_20261104/demo_grip_scene.usda@
    ]
)

over "dual_ar5_o6"
{
    over "Physics"
    {
        over "right_rh_thumb_cmc_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:targetPosition = 49.274372
        }

        over "right_rh_thumb_cmc_pitch" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:targetPosition = 8.021409
        }

        over "right_rh_thumb_ip" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:targetPosition = 14.919821
        }
    }
}

