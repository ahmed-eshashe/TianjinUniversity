#usda 1.0
(
    subLayers = [
        @/home/omen/teamwork_projects/tomato_cutting_right_arm/rl/scene/phase3.usda@
    ]
)

over "dual_ar5_o6"
{
    over "Geometry"
    {
        over "world"
        {
            over "torso_base_link"
            {
                over "left_AR5_5_07L_W4C4A2_base"
                {
                    over "left_AR5_5_07L_W4C4A2_link1"
                    {
                        over "left_AR5_5_07L_W4C4A2_link2"
                        {
                            over "left_AR5_5_07L_W4C4A2_link3"
                            {
                                over "left_AR5_5_07L_W4C4A2_link4"
                                {
                                    over "left_AR5_5_07L_W4C4A2_link5"
                                    {
                                        over "left_AR5_5_07L_W4C4A2_link6"
                                        {
                                            over "left_AR5_5_07L_W4C4A2_link7"
                                            {
                                                over "left_AR5_5_07L_W4C4A2_tcp"
                                                {
                                                    over "left_lh_rk_adapter"
                                                    {
                                                        over "left_lh_hand_base_link"
                                                        {
                                                            over "left_lh_thumb_metacarpals_base2"
                                                            {
                                                                over "left_lh_thumb_metacarpals"
                                                                {
                                                                    over "thumb_metacarpals"
                                                                    {
                                                                        over "thumb_metacarpals" (
                                                                            prepend apiSchemas = ["PhysicsMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
                                                                        )
                                                                        {
                                                                            uniform token physics:approximation = "convexDecomposition"
                                                                            custom int physxConvexDecompositionCollision:hullVertexLimit = 64
                                                                            custom int physxConvexDecompositionCollision:maxConvexHulls = 32
                                                                        }
                                                                    }
                                                                }

                                                                over "thumb_metacarpals_base2"
                                                                {
                                                                    over "thumb_metacarpals_base2" (
                                                                        prepend apiSchemas = ["PhysicsMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
                                                                    )
                                                                    {
                                                                        uniform token physics:approximation = "convexDecomposition"
                                                                        custom int physxConvexDecompositionCollision:hullVertexLimit = 64
                                                                        custom int physxConvexDecompositionCollision:maxConvexHulls = 32
                                                                    }
                                                                }
                                                            }

                                                            over "hand_base_link"
                                                            {
                                                                over "hand_base_link" (
                                                                    prepend apiSchemas = ["PhysicsMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
                                                                )
                                                                {
                                                                    uniform token physics:approximation = "convexDecomposition"
                                                                    custom int physxConvexDecompositionCollision:hullVertexLimit = 64
                                                                    custom int physxConvexDecompositionCollision:maxConvexHulls = 32
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

