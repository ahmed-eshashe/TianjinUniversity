"""Bounded sparse primal-feasible contact for one/two-DOF linear constraints.

Weighted graph elimination handles barycentric edge constraints exactly. No
penalty spring, dense full-system factorization or physics regularization.
"""
import numpy as np
from scipy.sparse import coo_matrix,tril,triu
from scipy.sparse.linalg import cg,LinearOperator,spsolve_triangular,lsmr
from tomato_volume_protection import InfeasibleVolume


def affine_space(C,b,fixed,size):
    """x=offset+T*q for active weighted pair/single equalities and supports."""
    C=C.tocsr();adj=[[] for _ in range(size)];anchors=dict(fixed)
    for row in range(C.shape[0]):
        j=C.indices[C.indptr[row]:C.indptr[row+1]];v=C.data[C.indptr[row]:C.indptr[row+1]]
        keep=np.abs(v)>1e-13;j=j[keep];v=v[keep]
        if len(j)==1:
            value=b[row]/v[0]
            if j[0] in anchors and abs(anchors[j[0]]-value)>1e-9:raise ValueError('Incompatible fixed/contact equality')
            anchors[j[0]]=value
        elif len(j)==2:
            a,z=map(int,j);u,w=v
            adj[a].append((z,-u/w,b[row]/w));adj[z].append((a,-w/u,b[row]/u))
        else:raise ValueError('Contact row must have one or two nonzero DOFs')
    seen=np.zeros(size,dtype=bool);offset=np.zeros(size);rows=[];cols=[];vals=[];column=0
    for root in range(size):
        if seen[root]:continue
        if not adj[root]:
            seen[root]=True
            if root in anchors:offset[root]=anchors[root]
            else:rows.append(root);cols.append(column);vals.append(1.);column+=1
            continue
        co={root:1.};off={root:0.};stack=[root];members=[];rootvalues=[];seen[root]=True
        while stack:
            a=stack.pop();members.append(a)
            if a in anchors:
                if abs(co[a])<1e-14:
                    if abs(off[a]-anchors[a])>1e-9:raise ValueError('Degenerate supported equality')
                else:rootvalues.append((anchors[a]-off[a])/co[a])
            for z,k,q in adj[a]:
                s=k*co[a];t=k*off[a]+q
                if not seen[z]:seen[z]=True;co[z]=s;off[z]=t;stack.append(z)
                else:
                    delta=co[z]-s;rhs=t-off[z]
                    if abs(delta)>1e-10*max(abs(co[z]),abs(s),1.):rootvalues.append(rhs/delta)
                    elif abs(rhs)>1e-9:raise ValueError('Incompatible equality cycle')
        if rootvalues:
            value=rootvalues[0]
            for j in members:offset[j]=off[j]+co[j]*value
            if any(abs(v-value)>1e-8*max(1.,abs(value)) for v in rootvalues):raise ValueError('Incompatible contact anchors')
        else:
            scale=np.linalg.norm([co[j] for j in members])
            for j in members:offset[j]=off[j];rows.append(j);cols.append(column);vals.append(co[j]/scale)
            column+=1
    T=coo_matrix((vals,(rows,cols)),shape=(size,column)).tocsr()
    if C.shape[0] and np.max(np.abs(C@offset-b))>1e-9:raise ValueError('Equality elimination residual')
    return offset,T


def feasible_guess(x,C,b,fixed):
    """Uncommitted halfspace projection; never repairs a committed trajectory."""
    x=x.copy();ids=np.array(sorted(fixed),dtype=int);x[ids]=[fixed[i] for i in ids];blocked=set(fixed)
    for _ in range(200):
        gaps=C@x-b
        if gaps.min()>=-1e-11:return x
        for row in np.flatnonzero(gaps < -1e-11):
            j=C.indices[C.indptr[row]:C.indptr[row+1]];v=C.data[C.indptr[row]:C.indptr[row+1]]
            free=np.array([i not in blocked for i in j]);j=j[free];v=v[free]
            gap=float((C.getrow(row)@x)[0]-b[row]);norm=float(v@v)
            if norm<=1e-24:raise ValueError('Infeasible contact against fixed support')
            if gap<0:x[j]+=(-gap+1e-12)*v/norm
    raise ValueError('Contact feasibility guess did not converge')


def independent_rows(C,candidates,fixed,size):
    """Linear-time weighted union/find rank filter for pair constraints."""
    parent=list(range(size));weight=np.ones(size);anchored=np.zeros(size,dtype=bool)
    anchored[list(fixed)]=True;selected=[]
    def find(i):
        if parent[i]!=i:
            p=parent[i];r,w=find(p);weight[i]*=w;parent[i]=r
        return parent[i],weight[i]
    for row in candidates:
        ids=C.indices[C.indptr[row]:C.indptr[row+1]];v=C.data[C.indptr[row]:C.indptr[row+1]]
        keep=np.abs(v)>1e-13;ids=ids[keep];v=v[keep]
        roots=[find(int(i)) for i in ids]
        if len(ids)==1:
            a,_=roots[0]
            if not anchored[a]:anchored[a]=True;selected.append(int(row))
        elif len(ids)==2:
            (a,u),(b,w)=roots;c,d=v[0]*u,v[1]*w
            if a==b:
                if abs(c+d)>1e-10*max(abs(c),abs(d),1.) and not anchored[a]:anchored[a]=True;selected.append(int(row))
            elif not (anchored[a] and anchored[b]):
                parent[a]=b;weight[a]=-d/c;anchored[b]=anchored[a] or anchored[b];selected.append(int(row))
        else:raise ValueError('Unsupported contact row size')
    return selected


def solve_linear_contact(model,initial,fixed,C,b,max_iterations=60):
    """Contact-set prediction by a cheap installed CPU QP, exact Newton polish.

    The QP's diagonal metric only predicts a feasible set. Actual Newton steps
    and final equilibrium use the unchanged full nonlinear model/Hessian.
    """
    import osqp
    from scipy.sparse import diags,eye
    C=C.tocsr();x=feasible_guess(np.asarray(initial).ravel(),C,b,fixed)
    ids=np.array(sorted(fixed),dtype=int);free=np.setdiff1d(np.arange(x.size),ids);Af=C[:,free]
    row_ids=np.flatnonzero(np.asarray(Af.multiply(Af).sum(axis=1)).ravel()>1e-24)
    trace=[];lam=np.zeros(len(b));success=False;active=None
    def predict(target,diagonal):
        D=diags(1/np.sqrt(diagonal));B=(Af[row_ids]@D).tocsr()
        scale=np.sqrt(np.asarray(B.multiply(B).sum(axis=1)).ravel());B=(diags(1/scale)@B).tocsc()
        qp=osqp.OSQP(algebra='builtin')
        qp.setup(P=eye(len(free),format='csc'),q=-np.sqrt(diagonal)*target[free],A=B,
            l=(b-C@x)[row_ids]/scale,u=np.full(len(row_ids),np.inf),eps_abs=1e-8,eps_rel=1e-8,
            max_iter=8000,polishing=True,verbose=False,check_termination=10,adaptive_rho=True)
        result=qp.solve(raise_error=False)
        if result.info.status_val not in (1,2) or not np.isfinite(result.y).all():raise ValueError('Contact-set QP predictor inconclusive: '+result.info.status)
        loads=np.zeros(len(b));loads[row_ids]=-result.y/scale
        return independent_rows(C,np.flatnonzero(loads>1e-9).tolist(),fixed,x.size)
    for iteration in range(max_iterations):
        state=model.evaluate(x.reshape(-1,3),tangent=True);g=state['gradient_n'].ravel();H=state['tangent_n_m'];diagonal=H.diagonal()[free]
        if np.any(diagonal<=0):raise ValueError('Nonpositive free diagonal')
        if active is None:
            target=np.zeros(x.size);target[free]=-g[free]/diagonal;active=predict(target,diagonal)
        for polish in range(20):
            if x.size>1000:print({'stage':'polish','newton':iteration,'inner':polish,'active':len(active)},flush=True)
            offset,T=affine_space(C[active],b[active],fixed,x.size);particular=offset+T@(T.T@(x-offset))-x
            h=(T.T@H@T).tocsr();rhs=-np.asarray(T.T@(g+H@particular)).ravel()
            if h.shape[0]:
                hd=h.diagonal()
                if np.any(hd<=0):raise ValueError('Nonpositive constrained diagonal')
                lower=tril(h,format='csr');upper=triu(h,format='csr')
                def precondition(v):return spsolve_triangular(upper,hd*spsolve_triangular(lower,v,lower=True),lower=False)
                answer,info=cg(h,rhs,M=LinearOperator(h.shape,matvec=precondition),rtol=1e-9,atol=1e-12,maxiter=2500)
                if info:raise ValueError('Exact contact CG inconclusive: '+str(info))
                direction=particular+T@answer
            else:direction=particular
            effective=g+H@direction;lam[:]=0.
            if active:
                result=lsmr(C[active][:,free].T,effective[free],atol=1e-12,btol=1e-12,maxiter=2500)
                if result[1] not in (0,1,2,4,5):raise ValueError('Multiplier solve inconclusive')
                lam[active]=result[0]
            negative=[i for i in active if lam[i]<-1e-9]
            if negative:
                active=[i for i in active if i not in negative];continue
            if (C@(x+direction)-b).min() < -1e-10:
                proposed=predict(direction,diagonal)
                if proposed==active:raise ValueError('Contact-set predictor stalled')
                active=proposed;continue
            break
        else:raise ValueError('Contact-set polish did not converge')
        residual=g-C.T@lam;norm=max(np.linalg.norm(g[ids]),np.linalg.norm(C.T@lam),1e-4)
        relative=float(np.linalg.norm(residual[free])/norm);gaps=C@x-b
        trace.append({'iteration':iteration,'force_residual':relative,'min_gap_m':float(gaps.min()),'energy_j':state['energy_j'],'polish_iterations':polish+1})
        if x.size>1000:print(trace[-1],flush=True)
        if relative<1e-7 and gaps.min()>=-1e-10 and lam.min()>=-1e-9 and np.max(np.abs(lam*gaps))<1e-10:
            success=True;break
        alpha=1.;accepted=False
        while alpha>1e-9:
            trial=x+alpha*direction
            try:
                proposed=model.evaluate(trial.reshape(-1,3))
                if (C@trial-b).min()>=-1e-10 and proposed['energy_j']<=state['energy_j']+1e-4*alpha*min(float(g@direction),0.)+1e-14:
                    accepted=True;break
            except InfeasibleVolume:pass
            alpha*=.5
        if not accepted:break
        x=trial
    state=model.evaluate(x.reshape(-1,3),tangent=True)
    return x.reshape(-1,3),lam,state,trace,success,active,ids,free
