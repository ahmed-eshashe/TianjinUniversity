    def Xform "lm0310_wheelbase" (
        prepend references = @./geometries.usd@</Geometries/lm0310_wheelbase>
    )
    {
        over "lm0310_wheelbase" (
            apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/lm0310_wheelbase/VisualMaterials/torso_grey>
            token physics:approximation = "convexHull"
        }

        def Scope "VisualMaterials"
        {
            def Material "torso_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/torso_grey>
            )
            {
            }
        }
    }

